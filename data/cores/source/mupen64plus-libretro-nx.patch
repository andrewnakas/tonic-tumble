+/* Clean-room placeholder microcode ("CRUCODE1" tag, see crucode.h): the tag names the family. */
+static bool _crucodeApply(MicrocodeInfo & current, u32 uc_start, u32 uc_dstart)
+{
+	crucode_info_t tag;
+	if (!crucode_probe_task(RDRAM, RDRAMSize + 1, uc_start, uc_dstart, &tag))
+		return false;
+	u32 type = NONE;
+	if (crucode_is(&tag, "f3d"))
+		type = F3D;
+	else if (crucode_is(&tag, "f3dex"))
+		type = F3DEX;
+	else if (crucode_is(&tag, "f3dex2") || crucode_is(&tag, "f3dex2_rej"))
+		type = F3DEX2;
+	else if (crucode_is(&tag, "f3dzex2_oot"))
+		type = F3DZEX2OOT;
+	else if (crucode_is(&tag, "f3dzex2_mm"))
+		type = F3DZEX2MM;
+	else if (crucode_is(&tag, "l3d"))
+		type = L3D;
+	else if (crucode_is(&tag, "l3dex"))
+		type = L3DEX;
+	else if (crucode_is(&tag, "l3dex2"))
+		type = L3DEX2;
+	else if (crucode_is(&tag, "s2dex"))
+		type = tag.version == 103 ? S2DEX_1_03 : (tag.version == 105 ? S2DEX_1_05 : S2DEX_1_07);
+	else if (crucode_is(&tag, "s2dex2"))
+		type = S2DEX2;
+	else if (crucode_is(&tag, "turbo3d"))
+		type = Turbo3D;
+	else if (crucode_is(&tag, "zsortp"))
+		type = ZSortp;
+	if (type == NONE) {
+		LOG(LOG_WARNING, "Unknown clean-room ucode tag '%s'", tag.family);
+		return false;
+	}
+	current.type = type;
+	current.Rej = (tag.flags & CRUCODE_FLAG_REJ) != 0 || crucode_is(&tag, "f3dex2_rej");
+	current.NoN = current.Rej || (tag.flags & CRUCODE_FLAG_NON) != 0;
+	if (tag.flags & CRUCODE_FLAG_LP) {
+		current.texturePersp = false;
+		current.NoN = true;
+	}
+	if (type == S2DEX_1_03 || type == S2DEX_1_05 || type == S2DEX_1_07 || type == S2DEX2)
+		current.texturePersp = false;
+	LOG(LOG_VERBOSE, "Load microcode from clean-room tag '%s' type: %d", tag.family, current.type);
+	return true;
+}
