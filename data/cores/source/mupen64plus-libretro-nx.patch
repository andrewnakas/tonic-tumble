@@ -393,12 +394,61 @@ static ucode_func_t non_task_detection(struct hle_t* hle)
     return &unknown_ucode;
 }
 
+/* Clean-room placeholder microcode ("CRUCODE1" tag, see crucode.h): the tag names the microcode
+ * family directly. A tagged task never goes to the LLE fallback (that would run the stub). */
+#define CRUCODE_HLE_RDRAM 0x800000
+static ucode_func_t crucode_task_detection(struct hle_t* hle, uint32_t type)
+{
+    crucode_info_t tag;
+    static const struct { const char *name; ucode_func_t fn; } audio[] = {
+        { "aspmain", &alist_process_audio }, { "libmus", &alist_process_audio },
+        { "aspmain_ge", &alist_process_audio_ge }, { "aspmain_bc", &alist_process_audio_bc },
+        { "naudio", &alist_process_naudio }, { "naudio_bk", &alist_process_naudio_bk },
+        { "naudio_dk", &alist_process_naudio_dk }, { "naudio_mp3", &alist_process_naudio_mp3 },
+        { "naudio_cbfd", &alist_process_naudio_cbfd },
+        { "nead_mk", &alist_process_nead_mk }, { "nead_sfj", &alist_process_nead_sfj },
+        { "nead_sf", &alist_process_nead_sf }, { "nead_wrjb", &alist_process_nead_wrjb },
+        { "nead_fz", &alist_process_nead_fz }, { "nead_efz", &alist_process_nead_efz },
+        { "nead_ys", &alist_process_nead_ys }, { "nead_1080", &alist_process_nead_1080 },
+        { "nead_oot", &alist_process_nead_oot }, { "nead_mm", &alist_process_nead_mm },
+        { "nead_mmb", &alist_process_nead_mmb }, { "nead_ac", &alist_process_nead_ac },
+        { "nead_mats", &alist_process_nead_mats },
+        { "musyx1", &musyx_v1_task }, { "musyx2", &musyx_v2_task },
+    };
+    size_t i;
+
+    if (!crucode_probe_task(hle->dram, CRUCODE_HLE_RDRAM, *dmem_u32(hle, TASK_UCODE),
+                            *dmem_u32(hle, TASK_UCODE_DATA), &tag))
+        return NULL;
+
+    if (crucode_is_audio(&tag)) {
+        if (hle->hle_aud)
+            return &send_alist_to_audio_plugin;
+        for (i = 0; i < sizeof(audio) / sizeof(audio[0]); i++)
+            if (crucode_is(&tag, audio[i].name))
+                return audio[i].fn;
+    }
+    else if (crucode_is_gfx(&tag)) {
+        if (hle->hle_gfx)
+            return &send_dlist_to_gfx_plugin;
+        HleErrorMessage(hle->user_defined, "clean-room ucode tag '%s' needs HLE graphics "
+                        "(DisplayListToGraphicsPlugin = True); LLE cannot run placeholder microcode", tag.family);
+        return &task_done;
+    }
+    HleWarnMessage(hle->user_defined, "unknown clean-room ucode tag '%s' (task type %u)", tag.family, type);
+    return &task_done;
+}
+
 static ucode_func_t task_detection(struct hle_t* hle)
 {
     if (is_task(hle)) {
         ucode_func_t uc_pfunc;
         uint32_t type = *dmem_u32(hle, TASK_TYPE);
 
+        uc_pfunc = crucode_task_detection(hle, type);
+        if (uc_pfunc)
+            return uc_pfunc;
+
         if (type == 2) {
             if (hle->hle_aud) {
                 return &send_alist_to_audio_plugin;
